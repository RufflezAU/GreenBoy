# The budget you tuned over 24 runs, not the one the 50% harness runs liked: 128 MB textures and a
# 1.5 s eviction were tuned at 50% internal resolution and re-upload textures constantly at 75%.
RX_VK_VRAM_MB=2800
RX_VK_TEX_MAX_MB=256
RX_VK_TEX_MAX_DIM=1024
RX_VK_MIRROR_MB=256
RX_VK_EVICT_MIN_MS=3000
# The two that are free wins regardless: a GPU marker write before every draw (2,300 a frame), and
# culling off only in the one RDNA 2 task shader instead of across every draw.
RX_VK_CHECKPOINTS=0
RX_VK_MESH_NOCULL=2c56dc1006942f74
RX_VK_PRECOMPILE=0
HOS_HANDHELD=1
HOS_REALTIME_FLOOR=10
RX_VK_BATCH_IDLE=1
RX_VK_FRAMEGEN=0
RX_VK_STAGING_IDLE_S=0
RX_VK_STAGING_KEEP_MB=256
HOS_SHORT_SLEEP_TIMER=1
HOS_SPIN_US=20
HOS_RESERVE_CORE=0
RX_VK_CHUNK=500
